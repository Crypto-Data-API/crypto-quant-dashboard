{
  "name": "@cqd/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Long-lived poller + SSE relay. The only process that talks to CryptoDataApi.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "jev:samples": "tsx scripts/jev-samples.ts",
    "kpi:sample": "tsx scripts/kpi-sample.ts"
  },
  "dependencies": {
    "@cqd/cda-client": "workspace:*",
    "@cqd/schemas": "workspace:*",
    "@typesafe-ai/sdk": "0.6.0",
    "eventsource-parser": "3.1.1",
    "ioredis": "5.11.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
