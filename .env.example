# ---------------------------------------------------------------------------
# Crypto Quant Dashboard environment. Copy to .env at the repo root:
#   cp .env.example .env
# Both apps/worker and apps/web load this root .env file.
# ---------------------------------------------------------------------------

# CryptoDataApi key (cdk_live_...), Pro or Pro Plus. Read ONLY by apps/worker; the web app
# reads this same file but ignores this variable, and the key never reaches the browser.
# Leave empty to run in keyless mode: the worker skips keyed endpoints, panels show
# "API key not configured", and the live tape replays the free 30-minute-delayed preview.
CDA_API_KEY=
CDA_BASE_URL=https://cryptodataapi.com

# Redis shared by the worker (writer) and the web app (reader). Defaults to
# redis://localhost:6379 when unset. Set it to "off" to skip Redis entirely. If Redis is
# unreachable, the worker keeps an in-memory cache and the web app reads through the
# worker's HTTP API instead.
REDIS_URL=redis://localhost:6379

# Worker HTTP server: status, fallback data reads and the SSE fan-out.
# (The web app runs on http://localhost:3001.)
WORKER_PORT=4100
WORKER_URL=http://localhost:4100
# Optional shared secret for the worker's /data and /status routes.
WORKER_TOKEN=
# CORS origin for the worker's public /stream endpoint (production: your web origin).
WORKER_CORS_ORIGIN=*

# Rate-limit budget. Pro Plus allows 120 req/min and 50,000 req/day per key, shared with any
# other tooling on the same key. The worker also reads the key's real limits from
# /auth/keys/me and lowers both numbers automatically for a smaller tier (Pro: 30/min, 10,000/day).
CDA_RATE_PER_MIN=100
CDA_DAILY_BUDGET=28000

# Live event stream source: auto | live | delayed | off
#   auto    = live CDA stream when a key is set, otherwise the keyless delayed preview
#   live    = live CDA stream only (Pro key required)
#   delayed = keyless /stream/delayed preview only (events are 30 minutes old)
STREAM_SOURCE=auto

# Coins polled for GEX and positioning on a schedule (others are fetched on demand).
GEX_SYMBOLS=BTC,ETH,SOL,HYPE
# Maximum on-demand datasets (drawers, L2 book, depth history) polled at once.
ON_DEMAND_MAX=16

# debug | info | warn | error
LOG_LEVEL=info

# Optional: point browsers straight at the worker's /stream endpoint in production
# (bypasses serverless duration limits on /api/stream). Leave empty in dev.
NEXT_PUBLIC_STREAM_URL=
