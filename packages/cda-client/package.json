{
  "name": "@cqd/cda-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed, rate-limit-aware client for CryptoDataApi, generated from openapi.json.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen": "node ./scripts/gen.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
